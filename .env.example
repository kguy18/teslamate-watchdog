# Copy to .env next to your docker-compose.yml. Never commit the real .env.

# --- MQTT (required) -------------------------------------------------------
# The Mosquitto broker in your Home Assistant LXC.
WATCHDOG_MQTT_HOST=192.168.1.10
WATCHDOG_MQTT_USERNAME=
WATCHDOG_MQTT_PASSWORD=

# --- Everything below is optional; these are the built-in defaults ---------
# TESLAMATE_URL=http://teslamate:4000/
# TESLAMATE_CONTAINER=teslamate
# DATABASE_CONTAINER=database
# Must be tcp:// or http:// — a unix:// socket path is rejected on purpose.
# DOCKER_HOST=tcp://watchdog-socket-proxy:2375
# DOCKER_TIMEOUT_SECONDS=10
# Only used when the database container has no Docker healthcheck.
# DATABASE_HOST=database
# DATABASE_PORT=5432
# TESLAMATE_SIGNIN_PATTERN=/sign[_-]?in
# Comma-separated. Override only if pre-flight showed a false positive against
# a logged-IN instance.
# TESLAMATE_SIGNIN_BODY_MARKERS=refresh token,access token,tokens[refresh_token],tokens[access_token]

# MQTT_PORT=1883
# MQTT_BASE_TOPIC=teslamate/watchdog
# TESLAMATE_HEALTH_TOPIC=teslamate/cars/1/healthy

# --- MQTT over TLS (optional) ---------------------------------------------
# MQTT_TLS=false
# A home-lab broker usually has a private/self-signed certificate, which the
# system CA store rejects. Point this at the CA that signed it — mount the file
# into the container — and certificate verification stays ON.
# MQTT_TLS_CA_CERT=/data/certs/ca.crt
# Last resort: disables certificate verification entirely. Prefer the CA above.
# MQTT_TLS_INSECURE=false

# CHECK_INTERVAL_SECONDS=60
# HTTP_TIMEOUT_SECONDS=10
# On by default. TeslaMate republishes `healthy` on every vehicle summary, so a
# gap in the heartbeat is real evidence the vehicle logger has stopped.
# STALENESS_DETECTION_ENABLED=true
# Tolerated heartbeat gap while driving or charging (publishes every few sec).
# MQTT_STALE_SECONDS=600
# Tolerated gap in every other state. MUST exceed TeslaMate's `suspend_min`
# setting — while suspended it stops polling entirely so the car can sleep, and
# publishes nothing for that whole window (21 min default, 30 with streaming).
# Raise this if you raise suspend_min in TeslaMate.
# MQTT_PARKED_STALE_SECONDS=5400

# FAILURE_CONFIRMATION_COUNT=3
# RECOVERY_CONFIRMATION_COUNT=2

# AUTO_RESTART_ENABLED=true
# RESTART_COOLDOWN_SECONDS=21600
# POST_RESTART_WAIT_SECONDS=90
# MAX_RESTARTS_PER_24_HOURS=2

# DIAGNOSTIC_DIR=/data/diagnostics
# Log window kept in diagnostic bundles (context for a human).
# DIAGNOSTIC_LOG_LOOKBACK=2h
# Log window used to DECIDE state. Must not exceed the diagnostic window.
# This is also how long a resolved auth incident stays latched, so keep it
# short; raise it only if your token-refresh retries are too slow to
# accumulate within it.
# LOG_ANALYSIS_LOOKBACK=15m
# DIAGNOSTIC_RETENTION_DAYS=14

# HA_DISCOVERY_ENABLED=true
# HA_DISCOVERY_PREFIX=homeassistant
# LOG_LEVEL=INFO
